@page "/"
@using ScaniFly.Models
@using ScaniFly.Services
@inject ProposalStateService ProposalStateService
@inject HistoryService HistoryService
@inject SettingsService SettingsService
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>Proposals - ScaniFly</PageTitle>

<div class="d-flex h-100 bg-white">
    <!-- Left Pane: List -->
    <div class="border-end d-flex flex-column bg-white" style="width: 400px; min-width: 400px; max-width: 400px;">
        <div class="p-4 border-bottom">
            <h2 class="h5 mb-1 fw-bold text-dark">Pending Proposals</h2>
            <p class="text-muted small mb-0">Select a document to review the AI suggestions.</p>
        </div>

        <div class="flex-grow-1 overflow-auto bg-light p-3">
            @if (ProposalStateService.ActiveProposals.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 mb-3 d-block text-secondary"></i>
                    <p class="fw-medium mb-1">No pending documents.</p>
                    <small>Monitoring folder for new scans.</small>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var proposal in ProposalStateService.ActiveProposals)
                    {
                        var isSelected = SelectedProposal?.Id == proposal.Id;
                        <div class="card border-0 shadow-sm transition-all @(isSelected ? "border-primary border-2 shadow-md" : "border-gray-200")"
                             style="cursor: pointer; transition: all 0.2s ease; border-radius: 10px;"
                             @onclick="() => SelectProposal(proposal)">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-start mb-2 gap-2">
                                    <i class="bi bi-file-earmark-pdf-fill text-danger mt-1"></i>
                                    <div class="flex-grow-1 min-w-0">
                                        <h6 class="mb-1 text-truncate fw-semibold" style="font-size: 0.95rem;" title="@proposal.SuggestedTitle">
                                            @proposal.SuggestedTitle
                                        </h6>
                                        <p class="mb-0 text-muted small text-truncate" title="@proposal.SuggestedDestinationFolder">
                                            <i class="bi bi-folder me-1"></i>@proposal.SuggestedDestinationFolder
                                        </p>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn btn-primary btn-sm flex-grow-1 fw-medium" @onclick="() => AcceptProposal(proposal)" @onclick:stopPropagation="true">
                                        Accept
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm flex-grow-1 fw-medium" @onclick="() => EditProposal(proposal)" @onclick:stopPropagation="true">
                                        Edit
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Right Pane: Preview -->
    <div class="flex-grow-1 d-flex flex-column bg-light">
        @if (SelectedProposal != null)
        {
            <div class="bg-white border-bottom p-3 px-4 d-flex justify-content-between align-items-center shadow-sm" style="z-index: 10;">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-light p-2 rounded text-secondary">
                        <i class="bi bi-file-earmark-text fs-5"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">@SelectedProposal.SuggestedTitle</h6>
                        <small class="text-muted">Original: @Path.GetFileName(SelectedProposal.OriginalFilePath)</small>
                    </div>
                </div>

                @if(IsEditing)
                {
                    <div class="d-flex gap-2 align-items-center bg-light p-2 rounded border">
                        <input type="text" class="form-control form-control-sm border-0 shadow-none" style="width: 200px;" @bind="EditTitle" placeholder="Title">
                        <div class="vr"></div>
                        <input type="text" class="form-control form-control-sm border-0 shadow-none" style="width: 250px;" @bind="EditDestination" placeholder="Destination Folder">
                        <button class="btn btn-success btn-sm ms-2 px-3" @onclick="SaveEdit">Save</button>
                        <button class="btn btn-light btn-sm px-3 border" @onclick="CancelEdit">Cancel</button>
                    </div>
                }
            </div>

            <div class="flex-grow-1 position-relative p-4 d-flex align-items-center justify-content-center" style="background-color: #e5e7eb;">
                @if (File.Exists(SelectedProposal.OriginalFilePath))
                {
                    <div class="w-100 h-100 shadow-lg" style="border-radius: 8px; overflow: hidden; max-width: 1200px;">
                        <iframe src="/api/pdf/preview/@SelectedProposal.Id" class="w-100 h-100 border-0 bg-white"></iframe>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted">
                        <i class="bi bi-file-earmark-x display-1 mb-3"></i>
                        <p class="fs-5">File not found</p>
                        <small>@SelectedProposal.OriginalFilePath</small>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                <div class="bg-white p-4 rounded-circle shadow-sm mb-4">
                    <i class="bi bi-eye text-primary" style="font-size: 3rem;"></i>
                </div>
                <h4 class="fw-semibold text-dark">Preview Panel</h4>
                <p>Select a document from the left to view its contents.</p>
            </div>
        }
    </div>
</div>

@code {
    private DocumentProposal? SelectedProposal;
    private bool IsEditing = false;
    private string EditTitle = "";
    private string EditDestination = "";
    private string RootOutputDir = "";

    protected override async Task OnInitializedAsync()
    {
        if (!(await SettingsService.IsConfiguredAsync()))
        {
            NavManager.NavigateTo("/settings");
            return;
        }

        ProposalStateService.OnStateChanged += StateHasChanged;
        var settings = await SettingsService.GetSettingsAsync();
        RootOutputDir = settings.OutputDirectory;

        if (ProposalStateService.ActiveProposals.Any())
        {
            SelectedProposal = ProposalStateService.ActiveProposals.First();
        }
    }

    public void Dispose()
    {
        ProposalStateService.OnStateChanged -= StateHasChanged;
    }

    private void SelectProposal(DocumentProposal proposal)
    {
        SelectedProposal = proposal;
        IsEditing = false;
    }

    private async Task AcceptProposal(DocumentProposal proposal)
    {
        try
        {
            if (File.Exists(proposal.OriginalFilePath))
            {
                string sanitizedDest = proposal.SuggestedDestinationFolder.Replace("..", "").TrimStart('\\', '/');
                string targetDir = Path.GetFullPath(Path.Combine(RootOutputDir, sanitizedDest));

                if (!targetDir.StartsWith(Path.GetFullPath(RootOutputDir) + Path.DirectorySeparatorChar))
                {
                    targetDir = Path.GetFullPath(RootOutputDir);
                }

                if (!Directory.Exists(targetDir))
                {
                    Directory.CreateDirectory(targetDir);
                }

                string finalTitle = proposal.SuggestedTitle;
                if (!finalTitle.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                {
                    finalTitle += ".pdf";
                    proposal.SuggestedTitle = finalTitle;
                }

                string targetPath = Path.Combine(targetDir, finalTitle);

                int counter = 1;
                while (File.Exists(targetPath))
                {
                    string nameWithoutExt = Path.GetFileNameWithoutExtension(finalTitle);
                    targetPath = Path.Combine(targetDir, $"{nameWithoutExt} ({counter}).pdf");
                    counter++;
                }

                File.Move(proposal.OriginalFilePath, targetPath);
            }

            await HistoryService.AddToHistoryAsync(proposal);
            ProposalStateService.RemoveProposal(proposal);

            if (SelectedProposal == proposal)
                SelectedProposal = ProposalStateService.ActiveProposals.FirstOrDefault();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error accepting proposal: {ex.Message}");
        }
    }

    private void EditProposal(DocumentProposal proposal)
    {
        SelectProposal(proposal);
        EditTitle = proposal.SuggestedTitle;
        EditDestination = proposal.SuggestedDestinationFolder;
        IsEditing = true;
    }

    private void SaveEdit()
    {
        if (SelectedProposal != null)
        {
            SelectedProposal.SuggestedTitle = EditTitle;
            SelectedProposal.SuggestedDestinationFolder = EditDestination;
        }
        IsEditing = false;
    }

    private void CancelEdit()
    {
        IsEditing = false;
    }
}
