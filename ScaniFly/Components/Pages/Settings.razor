@page "/settings"
@using ScaniFly.ViewModels
@using ScaniFly.Services
@using ScaniFly.Models
@using ElectronNET.API
@using ElectronNET.API.Entities
@inject SettingsService SettingsService
@inject OllamaService OllamaService
@inject IJSRuntime JSRuntime

<PageTitle>Settings - ScaniFly</PageTitle>

<div class="px-5 py-4 w-100" style="max-width: 900px; margin: 0 auto;">
    <h2 class="mb-4" style="font-weight: 600; color: var(--text-primary);">Settings</h2>

    @if (ShowOllamaWarning)
    {
        <div class="alert alert-warning d-flex align-items-center shadow-sm border-warning mb-4" role="alert" style="background-color: var(--warning-bg); color: var(--warning-text);">
            <i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>
            <div>
                Ollama is not running.
                <a href="https://ollama.com/download" target="_blank" class="alert-link ms-1">Click here to download or start it.</a>
            </div>
        </div>
    }

    @if (ShowSuccessMessage)
    {
        <div class="alert alert-success d-flex align-items-center shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-3 fs-5"></i>
            <div>Settings saved successfully!</div>
        </div>
    }

    <div class="card mb-4 border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">
            <h5 class="card-title mb-4" style="font-weight: 600;">Directory Configuration</h5>

            <div class="mb-4">
                <label for="monitoredDir" class="form-label text-muted small fw-bold mb-2">Monitored Directory</label>
                <div class="input-group">
                    <input type="text" class="form-control bg-light" id="monitoredDir" @bind="ViewModel.MonitoredDirectory" placeholder="Select the folder where new scanned PDFs will appear">
                    <button class="btn btn-light border px-4 fw-medium text-dark hover-bg-gray" type="button" @onclick="BrowseMonitoredDirectory">Browse</button>
                </div>
                <div class="form-text mt-2 text-muted">The folder where new scanned PDFs will appear.</div>
            </div>

            <div class="mb-2">
                <label for="outputDir" class="form-label text-muted small fw-bold mb-2">Default Output Directory</label>
                <div class="input-group">
                    <input type="text" class="form-control bg-light" id="outputDir" @bind="ViewModel.OutputDirectory" placeholder="Select the root folder where organized documents will be moved">
                    <button class="btn btn-light border px-4 fw-medium text-dark hover-bg-gray" type="button" @onclick="BrowseOutputDirectory">Browse</button>
                </div>
                <div class="form-text mt-2 text-muted">The root folder where organized documents will be moved.</div>
            </div>
        </div>
    </div>

    <div class="card mb-4 border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">
            <h5 class="card-title mb-4" style="font-weight: 600;">AI Configuration</h5>

            <div class="mb-4">
                <label for="ocrMethod" class="form-label text-muted small fw-bold mb-2">OCR Method</label>
                <select class="form-select bg-light" id="ocrMethod" @bind="ViewModel.OcrMethod">
                    <option value="Vision LLM">Vision LLM (e.g. LLaVA - Requires Ollama)</option>
                    <option value="Tesseract">Tesseract OCR (Standard text LLM)</option>
                    <option value="Native OS">Native OS OCR (Windows/Mac API)</option>
                </select>
                <div class="form-text mt-2 text-muted">How text is extracted from scanned images.</div>
            </div>

            <div class="mb-2">
                <label for="ollamaModel" class="form-label text-muted small fw-bold mb-2">Ollama Model <span class="badge bg-secondary ms-2 fw-normal" style="font-size: 0.7rem;">Fetched locally</span></label>
                <div class="d-flex gap-2 align-items-center">
                    <select class="form-select bg-light" id="ollamaModel" @bind="ViewModel.OllamaModel">
                        <option value="">Select a model...</option>
                        @foreach (var model in AvailableModels)
                        {
                            <option value="@model">@model</option>
                        }
                    </select>
                    <button class="btn btn-light border px-3" @onclick="CheckOllamaStatus" title="Refresh Models"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                <div class="form-text mt-2 text-muted">The local LLM used to classify and rename documents.</div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-5">
        <button class="btn btn-primary px-4 py-2" @onclick="SaveConfiguration" style="border-radius: 8px;">
            <span class="fw-medium">Save Configuration</span>
        </button>
    </div>
</div>

@code {
    private SettingsViewModel ViewModel = new();
    private List<string> AvailableModels = new();
    private bool ShowOllamaWarning = false;
    private bool ShowSuccessMessage = false;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetSettingsAsync();
        ViewModel.LoadFromSettings(settings);
        await CheckOllamaStatus();
    }

    private async Task CheckOllamaStatus()
    {
        ShowOllamaWarning = !(await OllamaService.IsRunningAsync());
        if (!ShowOllamaWarning)
        {
            AvailableModels = await OllamaService.GetAvailableModelsAsync();
        }
        else
        {
            AvailableModels.Clear();
        }
    }

    private async Task SaveConfiguration()
    {
        await SettingsService.SaveSettingsAsync(ViewModel.ToSettings());
        ShowSuccessMessage = true;
        StateHasChanged();

        await Task.Delay(3000);
        ShowSuccessMessage = false;
        StateHasChanged();
    }

    private async Task BrowseMonitoredDirectory()
    {
        if (HybridSupport.IsElectronActive)
        {
            var mainWindow = Electron.WindowManager.BrowserWindows.First();
            var options = new OpenDialogOptions
            {
                Properties = new OpenDialogProperty[] { OpenDialogProperty.openDirectory }
            };

            string[] result = await Electron.Dialog.ShowOpenDialogAsync(mainWindow, options);
            if (result.Length > 0)
            {
                ViewModel.MonitoredDirectory = result[0];
            }
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Native folder selection is only available when running within the Electron desktop app. Please enter the path manually.");
        }
    }

    private async Task BrowseOutputDirectory()
    {
        if (HybridSupport.IsElectronActive)
        {
            var mainWindow = Electron.WindowManager.BrowserWindows.First();
            var options = new OpenDialogOptions
            {
                Properties = new OpenDialogProperty[] { OpenDialogProperty.openDirectory }
            };

            string[] result = await Electron.Dialog.ShowOpenDialogAsync(mainWindow, options);
            if (result.Length > 0)
            {
                ViewModel.OutputDirectory = result[0];
            }
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Native folder selection is only available when running within the Electron desktop app. Please enter the path manually.");
        }
    }
}
